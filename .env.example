# Wajib: kunci OpenRouter. Hanya dibaca di sisi server.
OPENROUTER_API_KEY=

# Identitas aplikasi di dasbor OpenRouter (opsional).
SITE_URL=https://jaipong.rominur.com
SITE_NAME=Jaipong

# Model penulis lirik, tahap pertama (opsional).
# Pilihan lain yang bagus: anthropic/claude-sonnet-5, openai/gpt-5.6
COMPOSER_MODEL=google/gemini-3.7-flash

# Model musik yang membangkitkan audionya, tahap kedua (opsional).
# Lyria 3 Pro: lagu utuh, sekitar $0,08 per lagu — harga per lagu, bukan per token.
# Alternatif lebih murah: google/lyria-3-clip-preview (klip 30 detik, $0,04).
MUSIC_MODEL=google/lyria-3-pro-preview

# Pagar permintaan (opsional, sudah ada nilai bawaan).
MAX_OUTPUT_TOKENS=20000
MIN_DURATION_SEC=30
MAX_DURATION_SEC=240

# Batas pemakaian karena situs terbuka tanpa login (opsional).
# PERHATIAN BIAYA: tiap lagu memanggil model musik berbayar per lagu.
# Bawaan COMPOSE_GLOBAL_DAILY_LIMIT = 150 -> plafon ±$12/hari. Naikkan
# kalau situsnya ramai dan anggarannya memang ada.
COMPOSE_BURST_LIMIT=6
COMPOSE_BURST_WINDOW_SEC=300
COMPOSE_DAILY_LIMIT=40
COMPOSE_GLOBAL_DAILY_LIMIT=150

# Opsional: Upstash Redis REST supaya kuota tetap akurat lintas instance serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
